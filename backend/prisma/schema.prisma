generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProposalRequest {
  id                          String         @id @default(cuid())
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  status                      ProposalStatus @default(NEW)
  email                       String
  fullName                    String
  cpf                         String
  address                     String
  birthDate                   String
  phone                       String
  socialProfile               String?
  preferredContactMethod      String
  preferredContactMethodOther String?
  referralSource              String
  referralSourceOther         String?
  desiredWorkStart            String
  projectType                 String
  projectTypeOther            String?
  taxAgreement                Boolean
  paymentMethod               String
  paymentMethodOther          String?
  projectDetailsJson          Json
  internalNotes               String?
  paymentProofUploadedAt      DateTime?
  paymentProofUrl             String?
  pixKeySnapshot              String?
  referenceFilesJson          Json?
  paymentProofStorageKey      String?

  @@map("proposal_requests")
}

model AdminUser {
  id                     String    @id @default(cuid())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  name                   String
  email                  String    @unique
  passwordHash           String
  role                   AdminRole @default(ADMIN)
  approved               Boolean   @default(false)
  isActive               Boolean   @default(false)
  approvalToken          String?   @unique
  approvalTokenExpiresAt DateTime?

  @@map("admin_users")
}

model SiteSettings {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  whatsapp              String?
  instagram             String?

  maxProjectImages      Int      @default(20)
  maxProjectImageSizeMb Int      @default(10)

  @@map("site_settings")
}

model Project {
  id                      String          @id @default(cuid())
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  title                   String
  slug                    String          @unique
  category                ProjectCategory
  city                    String?
  state                   String?
  year                    Int?
  area                    String?
  description             String
  content                 String?
  featuredImage           String?
  published               Boolean         @default(true)
  featured                Boolean         @default(false)
  videoUrl                String?
  featuredImageStorageKey String?
  images                  ProjectImage[]

  @@map("projects")
}

model ProjectImage {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  projectId  String
  imageUrl   String
  storageKey String
  alt        String?
  sortOrder  Int      @default(0)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

enum ProposalStatus {
  NEW
  REVIEWING
  AWAITING_PAYMENT
  PAID
  SCHEDULED
  CLOSED
  CANCELED
}

enum AdminRole {
  OWNER
  ADMIN
}

enum ProjectCategory {
  RESIDENTIAL
  INTERIORS
  COMMERCIAL
  LANDSCAPE
  CONSULTING
  OTHER
}
